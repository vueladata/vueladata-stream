{
  "family": "vueladata-stream-producer-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "stream-producer",
      "image": "<ACCOUNT_ID>.dkr.ecr.us-east-1.amazonaws.com/vueladata/stream-producer:latest",
      "essential": true,
      "environment": [
        {
          "name": "RABBITMQ_HOST",
          "value": "rabbitmq.vueladata.local"
        },
        {
          "name": "RABBITMQ_PORT",
          "value": "5672"
        },
        {
          "name": "QUEUE_NAME",
          "value": "eventos_oooi_queue"
        },
        {
          "name": "STREAM_DELAY_SECONDS",
          "value": "1"
        },
        {
          "name": "TOTAL_VUELOS",
          "value": "100"
        }
      ],
      "secrets": [
        {
          "name": "RABBITMQ_USER",
          "valueFrom": "arn:aws:ssm:us-east-1:<ACCOUNT_ID>:parameter/vueladata/dev/rabbitmq/user"
        },
        {
          "name": "RABBITMQ_PASS",
          "valueFrom": "arn:aws:ssm:us-east-1:<ACCOUNT_ID>:parameter/vueladata/dev/rabbitmq/password"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/vueladata-stream-producer",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "stream-producer",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}
